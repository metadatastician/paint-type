;; Architecture decisions and development practices
;; Generated: 2026-07-26
;; Source of truth: ROADMAP.adoc, OPERATIONAL-STATUS.adoc, docs/architecture/
(meta
  (version "1.1.0")
  (project "paint.type")
  (last-updated "2026-07-26")
  (architecture-decisions
    ("ADR-0001 — Adopt Rhodium Standard Repository (RSR) template (docs/decisions/0001-adopt-rsr-standard.adoc)")
    ("Idris2 for ABI definitions — dependent types prove pointer non-nullability, layout correctness, FFI safety. Formal proofs in verification/proofs/idris2/")
    ("Zig for FFI bridge — zero-cost C ABI, no hidden allocations, no GC pauses. ABI-3/ABI-5/TP-3 proofs verified in Idris2")
    ("Rust with linear types for Ephapax — no aliased mutable tile access (Tile is !Copy + !Clone). 11 compositing ops, persistent UndoGraph, Layer/LayerStack, Brush engine")
    ("Gossamer as desktop shell — linearly-typed webview, not Electron or native widgets. Integrated v0.3.0, provides WebRTC transport scaffolding")
    ("AffineScript → typed-wasm for the bridge layer — generated from Idris2 ABI declarations. Draft .twasm at src/bridges/, paint-type#39 closed")
    ("RGBA16F tile format, 64x64 tiles — HDR-capable, GPU-friendly, no lossy conversion. PNG/RGBA16F round-trip support complete v0.3.0")
    ("CRDT-compatible tile merging for collaboration — LWW register per cell, pointwise merge, verified commutative/associative/idempotent")
    ("Plugin code never touches Ephapax directly — always through the typed-wasm API surface. WASM tier sandbox complete v0.4.0")
    ("casket-ssg for static site generation — pinned to v0.1.4 (8c3b772b). www/ site with CSP headers, security_headers/, .well-known/, resource_records/")
    ("Contractile trident from standards — must, trust, adjust, dust, intend. Canonical source: hyperpolymath/standards/.machine_readable/contractiles/"))
  (development-practices
    (code-review "required — 1+ approval for main branch")
    (branch-protection "enabled — main branch protected")
    (ci-cd "GitHub Actions — reusable workflows from hyperpolymath/standards")
    (rust-ci "GREEN on main — cargo test 98/98 + 1 doctest. Rust workflow: rust.yml")
    (zig-ci "GREEN on main — zig build test. Zig workflow: cross-platform.yml")
    (idris2-ci "idris-ci.yml: idris2 --check on ABI + verification proofs")
    (proof-ci "proofs.yml: Idris2, Lean4, Agda, Coq, TLA+ proof validation")
    (coverage "coverage.yml: cargo-llvm-cov LCOV (Rust) + kcov best-effort (Zig). Reporting only, no gate")
    (fuzz "fuzz-smoke.yml: 3 cargo-fuzz targets, 30s smoke per target. Best-effort, no gate")
    (e2e "e2e.yml: 9-stage pipeline orchestrator. Integration tests for full workflow")
    (static-analysis "static-analysis-gate.yml: multiple linters and scanners")
    (dogfood "dogfood-gate.yml: A2ML validation, K9 contract validation, format compliance")
    (governance "governance.yml: reusable from standards — CRG, contractile, compliance checks")
    (scorecard "scorecard.yml: reusable from standards — OpenSSF Scorecard monitoring"))
  (machine-readable
    (state "STATE.a2ml — project state, version, milestones, dependencies")
    (ecosystem "ECOSYSTEM.a2ml — ecosystem position, related projects, integration status")
    (meta "META.a2ml — this file: architecture decisions, development practices")
    (registry "REGISTRY.a2ml — generated from scripts/build-registry.sh")
    (currency "All .a2ml files generated from live tree, not hand-authored. Regeneration recipe: just standards-audit"))
  (compliance
    (spdx "SPDX headers in all source files. Validation: static-analysis-gate.yml")
    (license "MPL-2.0 primary, CC-BY-SA-4.0 for docs. License scanning: hypatia-scan.yml")
    (security "SECURITY.md, .github/SECURITY.md. Secret scanning: secret-scanner.yml")
    (contractiles "must, trust, adjust, dust, intend. Source: hyperpolymath/standards canonical templates")
    (crg "Component Readiness Grade: B (Pre-alpha, milestones closing). Target: A for v1.0.0"))
  (standards-alignment
    (DEP-09-compliance "CI reusables pinned to standards HEAD (2b6d30bba13d1ed7034fb03ec61b7011e4040896). Governance and scorecard workflows updated")
    (contractile-trident "Consumes canonical trident from hyperpolymath/standards. Local copies kept in sync via manual update (TODO: automate via script)")
    (machine-readable-currency "STATE.a2ml, ECOSYSTEM.a2ml, META.a2ml updated to reflect v0.3.0 closed, v0.4.0 closed, v0.5.0 closing")
    (next-steps "Implement just standards-audit for automated regeneration. Strengthen verify-manifests.yml to flag stale manifests")))
