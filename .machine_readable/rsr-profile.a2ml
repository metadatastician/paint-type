# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (c) 2026 Joshua Jewell (JoshuaJewell) <paint-type@pm.me>
#
# rsr-profile.a2ml — paint-type's declared RSR v2.0 capabilities.
#
# Authored in the A2ML record dialect (hyperpolymath/standards
# a2ml/RECORD-DIALECT-SPEC.adoc). It declares which capabilities this repo has,
# per TEMPLATE-APPLICABILITY-POLICY.adoc; the RSR v2.0 conformance oracle
# (hypatia Hypatia.Rules.RsrConformance) uses `capabilities` to compute the
# APPLICABLE criteria set — a gated criterion is scored only when its gating
# capability appears below; everything else is `na` and excluded from the
# denominator.
#
# paint-type is a cross-platform image editor with formal ABI, Rust engine,
# Zig FFI bridge, and Idris2 proofs.

[rsr-profile]
version = "1.0.0"
spec = "rsr-criteria-v2"
declares-against = "2.1.1"
# Effective capability set for paint-type
capabilities = [
  "rust",               # src/ephapax/ image engine in Rust with linear types
  "idris2",             # src/interface/Abi/ (dependent-typed ABI definitions)
  "zig",                # src/interface/ffi/ (zero-cost C ABI bridge)
  "affinescript",       # AffineScript for bridge layer (typed-wasm)
  "bash",               # scripts/*.sh automation
  "cli",                # CLI entry points
  "library",            # paint-type as a library
  "ffi",                # C-ABI FFI seam (Zig)
  "abi",                # formally specified ABI: Idris2 definitions
  "formal-proofs",      # verification/proofs/ (CRDT merge, undo graph, tile invariants)
  "docs-site",          # www/ static site
  "container",          # container/ + .devcontainer/
  "reproducible-build", # build/ Justfile
  "benchmarks",         # benches/ + tests/
  "governance-tier",    # GOVERNANCE.adoc + MAINTAINERS + CODEOWNERS
  "collaboration",      # Burble WebRTC + Groove discovery for real-time collaboration
]

[canon]
# ---------------------------------------------------------------------------
# ADDED 2026-09-23. This block did not exist. Without it the repo declared its
# conformance with two free-text strings ("rsr-criteria-v2" / "2.0.0-draft")
# and nothing failed when the canon moved — which is exactly the gap canon.lock
# exists to close, and exactly the failure recorded as F8 in hyperpolymath/
# standards docs/AUDIT.adoc ("A pin nothing verifies is not a binding").
#
# The canon has since moved to 2.1.1 (released 2026-09-19, tag canon-v2.1.1).
# `declares-against` above is bumped to match.
#
# Both sha256 values below were re-derived against the actual files in
# hyperpolymath/standards at canon v2.1.1 and MATCH. Only criteria and gates are
# pinned because those are the two the template's reverse-direction lockstep job
# compares. applicability and lifecycle are:
#   applicability 0-canon/TEMPLATE-APPLICABILITY-POLICY.adoc
#                 1c5caa467769a85cd173d9bf680f1836d3fc18859acfeb5dd8cd4163b0572662
#   lifecycle     0-canon/rsr/SCAFFOLD-LIFECYCLE.adoc
#                 2f405c9ed18e36c067b402cb303b45505f418cab06d90b9857f180950eee7aea
#
# NOTE: paint-type is a MINTED repo, not the spine, so the
# "spine-adopts-then-canon-releases" ordering rule is not its to satisfy. The
# proper home for this record is .machine_readable/PROVENANCE.a2ml, written at
# mint by build/just/repo-init.just — which never ran here. This block stands in
# for it until PROVENANCE.a2ml is authored or the repo is re-minted.
# ---------------------------------------------------------------------------
version         = "2.1.1"
# MUST equal canon.lock [canon.artifacts].criteria.sha256
criteria_sha256 = "6a5aa8857bd0d0d58ef48827938ca17c251b6b854dacf59d306388d61694d82a"
# MUST equal canon.lock [canon.artifacts].gates.sha256
gates_sha256    = "e70efd2f53c9445e30da4baf770366f04a4a84ffd844a01426e587e565b53e6a"
lockstep_since  = "2026-09-23"

[notes]
# paint-type capabilities:
#   rust - Ephapax image engine with linear types for tile safety
#   idris2 - ABI definitions with dependent types for pointer safety
#   zig - FFI bridge implementation
#   affinescript - typed-wasm bridge layer generated from Idris2
#   cli - command-line interface
#   library - paint-type can be used as a library
#   ffi - C ABI for cross-language integration
#   abi - formally verified ABI specifications
#   formal-proofs - in-tree proofs for CRDT properties, undo graph, tile invariants
#   docs-site - static documentation site
#   container - container configuration
#   reproducible-build - Justfile build system
#   benchmarks - performance and correctness tests
#   governance-tier - full governance documentation
#   collaboration - real-time collaboration via Burble + Groove
